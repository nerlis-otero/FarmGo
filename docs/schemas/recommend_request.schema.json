{
  "$defs": {
    "CropId": {
      "enum": [
        "corn",
        "cotton",
        "sorghum",
        "soybean",
        "wheat",
        "peanut",
        "oats_cover",
        "forage_grass"
      ],
      "title": "CropId",
      "type": "string"
    },
    "Priority": {
      "enum": [
        "Profit",
        "Water Saving",
        "Soil Health",
        "Balanced"
      ],
      "title": "Priority",
      "type": "string"
    }
  },
  "description": "POST /recommend. Se envía farm_id O (lat y lon).",
  "properties": {
    "farm_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Farm Id"
    },
    "lat": {
      "anyOf": [
        {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lat"
    },
    "lon": {
      "anyOf": [
        {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lon"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "current_crops": {
      "items": {
        "$ref": "#/$defs/CropId"
      },
      "title": "Current Crops",
      "type": "array"
    }
  },
  "required": [
    "priority"
  ],
  "title": "RecommendRequest",
  "type": "object"
}