{
  "$defs": {
    "AgentAnalysisSummary": {
      "properties": {
        "status": {
          "enum": [
            "complete",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "recommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation"
        },
        "alternatives": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "status"
      ],
      "title": "AgentAnalysisSummary",
      "type": "object"
    },
    "AgentDiscussionSummary": {
      "properties": {
        "agreements": {
          "items": {
            "type": "string"
          },
          "title": "Agreements",
          "type": "array"
        },
        "disagreements": {
          "items": {
            "type": "string"
          },
          "title": "Disagreements",
          "type": "array"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "title": "AgentDiscussionSummary",
      "type": "object"
    },
    "CropId": {
      "enum": [
        "corn",
        "cotton",
        "sorghum",
        "soybean",
        "wheat",
        "peanut",
        "oats_cover",
        "forage_grass"
      ],
      "title": "CropId",
      "type": "string"
    },
    "DimensionScores": {
      "properties": {
        "climate": {
          "maximum": 100,
          "minimum": 0,
          "title": "Climate",
          "type": "number"
        },
        "soil": {
          "maximum": 100,
          "minimum": 0,
          "title": "Soil",
          "type": "number"
        },
        "market": {
          "maximum": 100,
          "minimum": 0,
          "title": "Market",
          "type": "number"
        },
        "total": {
          "maximum": 100,
          "minimum": 0,
          "title": "Total",
          "type": "number"
        }
      },
      "required": [
        "climate",
        "soil",
        "market",
        "total"
      ],
      "title": "DimensionScores",
      "type": "object"
    },
    "FarmerVerdict": {
      "properties": {
        "best_crop_to_grow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Crop To Grow"
        },
        "best_crop_to_sell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Crop To Sell"
        },
        "recommended_rotation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommended Rotation"
        },
        "best_overall_crop": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Best Overall Crop"
        },
        "reasoning": {
          "title": "Reasoning",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "things_to_consider": {
          "items": {
            "type": "string"
          },
          "title": "Things To Consider",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "judge_used": {
          "title": "Judge Used",
          "type": "boolean"
        }
      },
      "required": [
        "reasoning",
        "confidence",
        "judge_used"
      ],
      "title": "FarmerVerdict",
      "type": "object"
    },
    "MultiAgentReport": {
      "properties": {
        "climate": {
          "$ref": "#/$defs/AgentAnalysisSummary"
        },
        "soil": {
          "$ref": "#/$defs/AgentAnalysisSummary"
        },
        "market": {
          "$ref": "#/$defs/AgentAnalysisSummary"
        },
        "discussion": {
          "additionalProperties": {
            "$ref": "#/$defs/AgentDiscussionSummary"
          },
          "title": "Discussion",
          "type": "object"
        },
        "verdict": {
          "$ref": "#/$defs/FarmerVerdict"
        }
      },
      "required": [
        "climate",
        "soil",
        "market",
        "discussion",
        "verdict"
      ],
      "title": "MultiAgentReport",
      "type": "object"
    },
    "Priority": {
      "enum": [
        "Profit",
        "Water Saving",
        "Soil Health",
        "Balanced"
      ],
      "title": "Priority",
      "type": "string"
    },
    "RotationResult": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "sequence": {
          "items": {
            "$ref": "#/$defs/CropId"
          },
          "title": "Sequence",
          "type": "array"
        },
        "is_current": {
          "title": "Is Current",
          "type": "boolean"
        },
        "scores": {
          "$ref": "#/$defs/DimensionScores"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "benefits": {
          "items": {
            "type": "string"
          },
          "title": "Benefits",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        },
        "risks": {
          "items": {
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "sequence",
        "is_current",
        "scores",
        "why",
        "evidence",
        "benefits",
        "gaps",
        "risks"
      ],
      "title": "RotationResult",
      "type": "object"
    }
  },
  "properties": {
    "farm_id": {
      "title": "Farm Id",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "best_rotation_id": {
      "title": "Best Rotation Id",
      "type": "string"
    },
    "rotations": {
      "items": {
        "$ref": "#/$defs/RotationResult"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Rotations",
      "type": "array"
    },
    "data_notes": {
      "items": {
        "type": "string"
      },
      "title": "Data Notes",
      "type": "array"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string"
    },
    "agent_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/MultiAgentReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "farm_id",
    "priority",
    "best_rotation_id",
    "rotations",
    "disclaimer"
  ],
  "title": "RecommendResponse",
  "type": "object"
}